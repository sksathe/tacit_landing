# Supabase Configuration (Backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Configuration (Frontend - Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Twilio Configuration
TWILIO_NUMBER=+19804995308

# LLM Configuration (for summary generation)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
# OR use Anthropic:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Server API Port (default: 3001)
PORT=3001

# MCP Agent Port (default: 3002)
# Note: Set this in mcp-agent/.env if different from server-api
